{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elicit-als-codemode-pattern-repro",
  "main": "src/host.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "worker_loaders": [
    { "binding": "LOADER" }
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "ReproMCP", "name": "MCP_OBJECT" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ReproMCP"] }
  ],
  "vars": {}
}
