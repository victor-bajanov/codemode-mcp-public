{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  // Security-review POCs import sibling packages by relative path and run only
  // under vitest.poc.config.ts; keep them out of the package typecheck.
  "exclude": ["src/__tests__/security-poc"]
}
