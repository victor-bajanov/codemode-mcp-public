{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gmail",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "gmail-codemode-mcp.example.com", "custom_domain": true }
  ],
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID" }
  ],
  "r2_buckets": [
    { "binding": "STAGING_R2", "bucket_name": "gmail-staging" }
  ],
  "d1_databases": [
    { "binding": "STAGING_D1", "database_name": "gmail-staging", "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID", "migrations_dir": "../../packages/scaffold/src/staging/migrations" }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "worker_loaders": [
    { "binding": "LOADER" }
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "GmailMCP", "name": "MCP_OBJECT" },
      { "class_name": "GmailTokenBroker", "name": "TOKEN_BROKER" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GmailMCP"] },
    { "tag": "v2", "new_sqlite_classes": ["GmailTokenBroker"] }
  ],
  "vars": {
    "GMAIL_API_BASE": "https://www.googleapis.com",
    "DEPLOYMENT_NAME": "gmail",
    // Per-deployment outbound recipient allowlist (comma-separated; "*@domain"
    // or exact address). Unset/empty ⇒ ALL sends, draft-sends, sendAs.create
    // and calendar invites are denied (fail closed) — reads are unaffected.
    "OUTBOUND_RECIPIENT_ALLOWLIST": "*@example.com,adam@gmail.com",
    "ALLOW_PII_IN_LOGS": "false",
    "DEBUG_ELICIT": "false",
    "STAGING_UPLOAD_TTL_SECONDS": "300",
    "STAGING_FETCH_TTL_SECONDS": "3600",
    "STAGING_MAX_BYTES": "52428800",
    "STAGING_UPLOAD_ORIGIN": "https://gmail.your-subdomain.workers.dev",
    "OAUTH_REGISTER_RATE_LIMIT": "1",
    "OAUTH_REGISTER_RATE_LIMIT_WINDOW_SECONDS": "300",
    "OAUTH_TOKEN_RATE_LIMIT": "20",
    "OAUTH_TOKEN_RATE_LIMIT_WINDOW_SECONDS": "60",
    "OAUTH_CLIENT_TTL_SECONDS": "2592000"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "dev": {
      "name": "gmail-dev",
      // Block inheritance of the top-level prod custom-domain route —
      // custom domains are exclusive, so an inheriting dev deploy steals it.
      "routes": [],
      "kv_namespaces": [
        { "binding": "OAUTH_KV", "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID" }
      ],
      "r2_buckets": [
        { "binding": "STAGING_R2", "bucket_name": "gmail-dev-staging" }
      ],
      "d1_databases": [
        { "binding": "STAGING_D1", "database_name": "gmail-dev-staging", "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID", "migrations_dir": "../../packages/scaffold/src/staging/migrations" }
      ],
      "triggers": { "crons": ["*/5 * * * *"] },
      "worker_loaders": [
        { "binding": "LOADER" }
      ],
      "durable_objects": {
        "bindings": [
          { "class_name": "GmailMCP", "name": "MCP_OBJECT" },
          { "class_name": "GmailTokenBroker", "name": "TOKEN_BROKER" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["GmailMCP"] },
        { "tag": "v2", "new_sqlite_classes": ["GmailTokenBroker"] }
      ],
      "vars": {
        "GMAIL_API_BASE": "https://www.googleapis.com",
        "DEPLOYMENT_NAME": "gmail-dev",
        "OUTBOUND_RECIPIENT_ALLOWLIST": "*@example.com,adam@gmail.com",
        "ALLOW_PII_IN_LOGS": "false",
        "DEBUG_ELICIT": "false",
        "STAGING_UPLOAD_TTL_SECONDS": "300",
        "STAGING_FETCH_TTL_SECONDS": "3600",
        "STAGING_MAX_BYTES": "52428800",
        "STAGING_UPLOAD_ORIGIN": "https://gmail-dev.your-subdomain.workers.dev",
        "OAUTH_REGISTER_RATE_LIMIT": "1",
        "OAUTH_REGISTER_RATE_LIMIT_WINDOW_SECONDS": "300",
        "OAUTH_TOKEN_RATE_LIMIT": "20",
        "OAUTH_TOKEN_RATE_LIMIT_WINDOW_SECONDS": "60",
        "OAUTH_CLIENT_TTL_SECONDS": "2592000"
      }
    },
    "tester": {
      "name": "gmail-tester",
      // Block inheritance of the top-level prod custom-domain route —
      // custom domains are exclusive, so an inheriting deploy steals it.
      // This deployment is workers.dev-only.
      "routes": [],
      "kv_namespaces": [
        { "binding": "OAUTH_KV", "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID" }
      ],
      "r2_buckets": [
        { "binding": "STAGING_R2", "bucket_name": "gmail-tester-staging" }
      ],
      "d1_databases": [
        { "binding": "STAGING_D1", "database_name": "gmail-tester-staging", "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID", "migrations_dir": "../../packages/scaffold/src/staging/migrations" }
      ],
      "triggers": { "crons": ["*/5 * * * *"] },
      "worker_loaders": [
        { "binding": "LOADER" }
      ],
      "durable_objects": {
        "bindings": [
          { "class_name": "GmailMCP", "name": "MCP_OBJECT" },
          { "class_name": "GmailTokenBroker", "name": "TOKEN_BROKER" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["GmailMCP"] },
        { "tag": "v2", "new_sqlite_classes": ["GmailTokenBroker"] }
      ],
      "vars": {
        "GMAIL_API_BASE": "https://www.googleapis.com",
        "DEPLOYMENT_NAME": "gmail-tester",
        // Tester's own outbound surface — independent of the operator's
        // deployments. Extend with exact addresses as the tester needs them.
        "OUTBOUND_RECIPIENT_ALLOWLIST": "*@tester.example.com",
        "ALLOW_PII_IN_LOGS": "false",
        "DEBUG_ELICIT": "false",
        "STAGING_UPLOAD_TTL_SECONDS": "300",
        "STAGING_FETCH_TTL_SECONDS": "3600",
        "STAGING_MAX_BYTES": "52428800",
        "STAGING_UPLOAD_ORIGIN": "https://gmail-tester.your-subdomain.workers.dev",
        "OAUTH_REGISTER_RATE_LIMIT": "1",
        "OAUTH_REGISTER_RATE_LIMIT_WINDOW_SECONDS": "300",
        "OAUTH_TOKEN_RATE_LIMIT": "20",
        "OAUTH_TOKEN_RATE_LIMIT_WINDOW_SECONDS": "60",
        "OAUTH_CLIENT_TTL_SECONDS": "2592000"
      }
    }
  }
}
