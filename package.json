{
  "name": "codemode-mcp",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "deploy:gmail": "pnpm --filter @apps/gmail run deploy",
    "deploy:gmail:dev": "pnpm --filter @apps/gmail run deploy:dev",
    "deploy:gmail:tester": "pnpm --filter @apps/gmail run deploy:tester",
    "deploy:xero": "pnpm --filter @apps/xero run deploy",
    "deploy:xero:dev": "pnpm --filter @apps/xero run deploy:dev",
    "deploy:optical": "pnpm --filter @apps/optical run deploy",
    "deploy:optical:dev": "pnpm --filter @apps/optical run deploy:dev",
    "harness:mcp": "tsx scripts/harnesses/mcp-client.ts",
    "harness:cookie": "tsx scripts/harnesses/cookie-absence.ts",
    "test:harness": "tsc -p scripts/harnesses && node --import tsx --test scripts/harnesses/staging-ladder.test.ts scripts/harnesses/xero-ladder.test.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240924.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^22.19.17",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "undici": "7.24.8"
  }
}
