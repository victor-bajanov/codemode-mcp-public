# Loaded via `op run --env-file=.env -- tofu <cmd>` and the deploy scripts.
# Copy to .env and adjust the op:// references if your vault layout differs.
#
# Cloudflare provider auth (scoped API token — mint via infra/create-api-token.sh).
# Same token is used by tofu and wrangler.
CLOUDFLARE_API_TOKEN="op://YourVault/<item>/credential"

# Lets wrangler skip its /memberships preflight, which would otherwise need a
# user-scoped Memberships Read perm on the token.
CLOUDFLARE_ACCOUNT_ID="op://YourVault/<item>/credential"

# OpenTofu input variables (TF_VAR_<name> — OpenTofu reads these for compat):
TF_VAR_cloudflare_account_id="op://YourVault/<item>/credential"

# Non-secret inputs — fill in literally (no op:// reference needed):
TF_VAR_cloudflare_workers_subdomain="your-workers-subdomain"
# JSON list syntax — tofu parses TF_VAR_<list-typed-var> as JSON.
TF_VAR_allowed_emails='["you@example.com"]'
TF_VAR_access_allowed_idp_ids='["00000000-0000-0000-0000-000000000000"]'
